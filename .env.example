# ==============================================================================
# COLLEGE NO-DUE CLEARANCE MANAGEMENT SYSTEM (ClearCampus)
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual institutional values.
# IMPORTANT: Never commit .env or actual secret credentials to source control.
# ==============================================================================

# Institutional Configuration — Cauvery Institute of Technology
VITE_COLLEGE_NAME="Cauvery Institute of Technology"
VITE_UNIVERSITY="VTU"
VITE_ACADEMIC_YEAR="2026-2027"
VITE_SYSTEM_NAME="College No-Due Clearance Management System"
VITE_DEFAULT_ATTENDANCE_THRESHOLD=85

# Public Supabase Configuration (Frontend Safe)
# Obtain these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Privileged Supabase Service-Role Key (BACKEND / SERVER SCRIPTS ONLY)
# CAUTION: Never prefix with VITE_ and NEVER expose in client-side code.
# Used strictly for server-side migrations, RLS bypass scripts, and administrative provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Initial Administrator Account Setup (CLI / Server Bootstrap Only)
# Used by scripts/bootstrap_initial_admin.mjs to securely provision the primary admin account.
INITIAL_ADMIN_EMAIL=admin@cauvery.edu.in
INITIAL_ADMIN_PASSWORD=SetAStrongTemporaryPassword123!
